
APP_NAME=Social Media Session Dashboard
DATABASE_URL=sqlite:///./data/app.db
# Set once to the username of an existing account to bootstrap the first administrator.
# INITIAL_ADMIN_USERNAME=
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=3600
OBSERVATION_RETENTION_DAYS=90
NETWORK_STORE_IP_ADDRESSES=false
NETWORK_CAPTURE_ENABLED=false
NETWORK_CAPTURE_INTERFACE=
NETWORK_CAPTURE_DURATION_SECONDS=10
TSHARK_EXECUTABLE=
BROWSER_ACTIVITY_INACTIVITY_THRESHOLD_SECONDS=300
META_APP_ID=
META_REDIRECT_URI=http://127.0.0.1:8000/social/oauth/callback
META_OAUTH_SCOPES=
META_AUTHORIZATION_URL=https://www.facebook.com/v24.0/dialog/oauth
META_DEMO_MODE=true
OAUTH_STATE_TTL_SECONDS=600
